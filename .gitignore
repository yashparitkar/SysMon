t KiCad ########################################################################
# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local project settings
*.kicad_prl

# STM32CubeIDE #################################################################
Debug/
Release/
*.launch
*.cfg
*.svd

# STM32Cube generated (keep your edits, ignore generated)
Middlewares/*
!Middlewares/Third_Party
!Middlewares/Third_Party/*
Drivers/

# IDE metadata
.metadata/
.settings/
.cproject
.project

# Linker + map files
*.ld
*.map

# Startup (auto-generated by CubeMX)
startup_*.s

# Python #######################################################################
__pycache__/
*.pyc
*.pyo
.env
venv/

# VS Code ######################################################################
.vscode/

# Zim Notebook #################################################################
Notebook/5_Cost*

# Temporary files
*.tmp
*.swp